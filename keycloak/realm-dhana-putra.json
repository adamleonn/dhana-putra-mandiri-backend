{
  "realm": "dhana-putra",
  "displayName": "CV Dhana Putra Mandiri",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "client": {
      "dhana-putra-api": [
        { "name": "direktur", "description": "Direktur: akses penuh & tutup/buka periode akuntansi" },
        { "name": "admin", "description": "Admin operasional: faktur, pembayaran, master data" },
        { "name": "gudang", "description": "Gudang: konfirmasi BPB & surat jalan, tanpa nilai rupiah" },
        { "name": "stakeholder", "description": "Stakeholder: hanya-baca laporan & dashboard" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "dhana-putra-api",
      "name": "Dhana Putra API (Django REST Framework)",
      "description": "Resource server. Tidak dipakai untuk login; menjadi audience access token dan pemilik client role aplikasi.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "dhana-putra-web",
      "name": "Dhana Putra Web (Next.js BFF)",
      "description": "Confidential client untuk Authorization Code Flow + PKCE (S256). Secret dibuat Keycloak saat import.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:3000/api/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login*",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-dhana-putra-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dhana-putra-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "dhana-putra-api": [
      { "client": "dhana-putra-web", "roles": ["direktur", "admin", "gudang", "stakeholder"] }
    ]
  },
  "users": [
    {
      "username": "direktur",
      "enabled": true,
      "email": "direktur@dhanaputra.local",
      "emailVerified": true,
      "firstName": "Direktur",
      "lastName": "Utama",
      "clientRoles": { "dhana-putra-api": ["direktur"] }
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@dhanaputra.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Operasional",
      "clientRoles": { "dhana-putra-api": ["admin"] }
    },
    {
      "username": "gudang",
      "enabled": true,
      "email": "gudang@dhanaputra.local",
      "emailVerified": true,
      "firstName": "Kepala",
      "lastName": "Gudang",
      "clientRoles": { "dhana-putra-api": ["gudang"] }
    },
    {
      "username": "stakeholder",
      "enabled": true,
      "email": "stakeholder@dhanaputra.local",
      "emailVerified": true,
      "firstName": "Stakeholder",
      "lastName": "Komisaris",
      "clientRoles": { "dhana-putra-api": ["stakeholder"] }
    },
    {
      "username": "tanpa-peran",
      "enabled": true,
      "email": "tanpa-peran@dhanaputra.local",
      "emailVerified": true,
      "firstName": "Pengguna",
      "lastName": "Tanpa Peran"
    }
  ]
}
