# Application Environment
APP_ENV=development
DEBUG=True
DEMO_MODE=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Jakarta

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dhana_putra_mandiri_dev
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration (Next.js Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authlib / OIDC Configuration Placeholders
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_SERVER_METADATA_URL=https://auth.example.com/.well-known/openid-configuration
OIDC_API_AUDIENCE=your-api-audience
