# =============================================================================
# Backend Django REST Framework — contoh konfigurasi (salin ke .env)
# JANGAN commit .env. Isi nilai rahasia dari secret manager / lokal saja.
# =============================================================================

# Application Environment: development | production
APP_ENV=development
DEBUG=True
# Wajib diisi di production (python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Jakarta

# Database Configuration (PostgreSQL)
DB_NAME=dhana_putra_mandiri_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS: browser memanggil API lewat BFF Next.js (server-to-server).
# Origin frontend tetap diizinkan, tanpa kredensial/cookie lintas origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origin tepercaya untuk form ber-CSRF (Django Admin)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:8001
# Cookie Django Admin. Production: True (otomatis bila APP_ENV=production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# OAuth 2.0 / OpenID Connect — Resource Server (validasi access token JWT)
# -----------------------------------------------------------------------------
# Issuer realm Keycloak (lokal). Production wajib https://
OIDC_ISSUER=http://localhost:8080/realms/dhana-putra
# Opsional, default: <OIDC_ISSUER>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
# Opsional, override jwks_uri dari discovery
OIDC_JWKS_URL=
# Nilai yang wajib ada di klaim `aud` (client API di Keycloak)
OIDC_API_AUDIENCE=dhana-putra-api
OIDC_ALLOWED_ALGORITHMS=RS256
# Allowlist client (`azp`) yang boleh memanggil API. Wajib di production.
OIDC_ALLOWED_CLIENT_IDS=dhana-putra-web
# Path klaim role (dot-notation, pisah koma)
OIDC_ROLE_CLAIM_PATHS=resource_access.dhana-putra-api.roles
# Pemetaan role IdP -> peran aplikasi (direktur|admin|gudang|stakeholder)
OIDC_ROLE_MAPPING=direktur:direktur,admin:admin,gudang:gudang,stakeholder:stakeholder
# Toleransi clock skew (detik) untuk exp/nbf/iat
OIDC_LEEWAY_SECONDS=30
OIDC_JWKS_CACHE_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=5
# Migrasi pengguna lama: login OIDC pertama ditautkan ke user lokal ber-username
# sama yang belum tertaut. Matikan setelah migrasi selesai.
OIDC_LINK_EXISTING_BY_USERNAME=True
OIDC_AUTO_CREATE_USERS=True
